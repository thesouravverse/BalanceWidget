<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon background: pitch-black square with a subtle radial highlight
  in deep purple→black to nod toward the CRED-style hero gradient inside the app.
  Rendered at 108x108 dp. Launchers crop to a circle/squircle/round-square as needed.
-->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">

    <!-- Pitch-black base -->
    <path
        android:fillColor="#0A0A0A"
        android:pathData="M0,0 L108,0 L108,108 L0,108 Z" />

    <!-- Soft purple radial highlight, off-center top-left for depth -->
    <path android:pathData="M0,0 L108,0 L108,108 L0,108 Z">
        <aapt:attr xmlns:aapt="http://schemas.android.com/aapt"
            name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="38"
                android:centerY="38"
                android:gradientRadius="70"
                android:startColor="#332D1B69"
                android:endColor="#000A0A0A" />
        </aapt:attr>
    </path>
</vector>
