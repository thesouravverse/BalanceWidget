<?xml version="1.0" encoding="utf-8"?>
<!--
  Android 12+ (S+) data-extraction rules.
  Cloud = Auto Backup to user's Google Drive.
  Device transfer = direct phone-to-phone copy on setup.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="datastore/" />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
